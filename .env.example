# Aplicação
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres

# PostgreSQL
DATABASE_URL=postgres://mago_bot:troque-a-senha@127.0.0.1:5432/mago_bot
DATABASE_SSL=false

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Licenciamento: local não depende de app.mago-bot.com; remote é opcional
LICENSE_MODE=local
LICENSE_API_BASE_URL=https://app.mago-bot.com
LICENSE_PROJECT_SLUG=mago-bot
LICENSE_DOMAIN=mago-bot.com
LICENSE_ADMIN_TOKEN=
WHATSAPP_LICENSE_TOKEN=

# API operacional do WhatsApp (quando estiver disponível)
WHATSAPP_PROVIDER=stub
WHATSAPP_API_BASE_URL=
WHATSAPP_API_KEY=
EVOLUTION_INSTANCES_PATH=/instance/fetchInstances
EVOLUTION_CREATE_PATH=/instance/create
EVOLUTION_CONNECT_PATH=/instance/connect/{instance}
EVOLUTION_LOGOUT_PATH=/instance/logout/{instance}
EVOLUTION_SEND_TEXT_PATH=/message/sendText/{instance}
WHATSAPP_WEBHOOK_SECRET=troque-por-um-segredo-exclusivo-de-webhook
RATE_LIMIT_SIGNUP_PER_HOUR=3
# Obrigatória para salvar tokens da Central de APIs; gere com: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# IA server-side: deixe stub para operar sem chave; ative os provedores conforme necessário
AI_PRIMARY_PROVIDER=stub
AI_FALLBACK_PROVIDER=stub
AI_PRIMARY_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=512
AI_REQUESTS_PER_MINUTE=60
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
WHISPER_API_KEY=
WHISPER_API_BASE_URL=
WHISPER_MODEL=whisper-1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# RAG semântico opcional; sem chave permanece no ranking lexical
EMBEDDING_PROVIDER=none
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v3
RERANK_PROVIDER=none
RERANK_MODEL=jina-reranker-v2-base-multilingual

# Mercado Pago — sandbox; credenciais ficam somente no ambiente server-side
MP_ENVIRONMENT=test
MP_API_BASE_URL=https://api.mercadopago.com
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_MAX_AGE_SECONDS=86400
MP_LIVE_ENABLED=false

# Retenção: false mantém somente dry-run; nunca ative sem backup e revisão operacional
RETENTION_CLEANUP_ENABLED=false

# Primeiro administrador — usado somente por npm run db:seed
BOOTSTRAP_ORG_NAME=Mago Bot
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@mago-bot.com
BOOTSTRAP_ADMIN_PASSWORD=troque-imediatamente
